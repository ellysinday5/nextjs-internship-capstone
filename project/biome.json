{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!dist",
      "!pnpm-lock.yaml",
      "!*.disabled*"
    ]
  }
}
